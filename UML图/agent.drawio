        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class AgentService {\n    +Config config\n    +run(question) str\n    +reset_session()\n  }\n  class AgentGraph {\n    +State state\n    +build() AgentGraph\n    +invoke(input) State\n  }\n  class State {\n    +list messages\n    +str intent\n    +list tool_results\n    +dict memory\n  }\n  class RouterNode {\n    +str name\n    +call(state) State\n    +route(state) str\n  }\n  class ToolExecutorNode {\n    +str name\n    +call(state) State\n  }\n  class ResponseNode {\n    +str name\n    +call(state) State\n  }\n  class LLMClient {\n    &lt;&lt;interface&gt;&gt;\n    +chat(messages) str\n    +embed(text) list\n  }\n  class OpenAILLMClient {\n    +str model\n    +chat(messages) str\n  }\n  class LocalLLMClient {\n    +chat(messages) str\n  }\n  class Tool {\n    &lt;&lt;interface&gt;&gt;\n    +str name\n    +run(args) str\n  }\n  class ToolRegistry {\n    +dict tools\n    +register(tool)\n    +execute(name, args) str\n  }\n  class MemoryStore {\n    +str session_id\n    +save(record)\n    +load(session_id) list\n  }\n  class Config {\n    +str llm_provider\n    +str model_name\n    +int max_rounds\n  }\n  AgentService --&gt; AgentGraph : builds\n  AgentService --&gt; MemoryStore : persists\n  AgentService --&gt; Config : reads\n  AgentGraph --&gt; State : manages\n  AgentGraph *-- RouterNode\n  AgentGraph *-- ToolExecutorNode\n  AgentGraph *-- ResponseNode\n  RouterNode --&gt; LLMClient : uses\n  ToolExecutorNode --&gt; ToolRegistry : invokes\n  LLMClient &lt;|-- OpenAILLMClient\n  LLMClient &lt;|-- LocalLLMClient\n  ToolRegistry o-- Tool\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="73">
